# Copy to `.env` (git-ignored) to override the defaults. Any SQLAlchemy URL works:
#   sqlite:///./flowlane.sqlite3                   file relative to the working directory
#   sqlite:///C:/data/flowlane.sqlite3             absolute path
#   postgresql+psycopg://user:pass@host/flowlane   later — driver not installed yet
# Default when unset: sqlite:///<repo>/server/flowlane.sqlite3
DATABASE_URL=sqlite:///./flowlane.sqlite3

# Set to 1 to log every SQL statement.
SQL_ECHO=0
